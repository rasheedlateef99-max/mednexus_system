# ============================================================
# MedNexus Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# This file (.env.example) is safe to commit — it contains
# no real secrets, only documentation of required variables.
# ============================================================


# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=MedNexus
APP_VERSION=0.1.0

# Set to True in development, False in production
DEBUG=True

# Options: development | staging | production
# Controls CORS policy — development allows all origins,
# production restricts to the domains listed in main.py
ENVIRONMENT=development

# API route prefix — do not change unless intentional
API_V1_PREFIX=/api/v1


# ── Databases ─────────────────────────────────────────────────────────────────
# Tenant database — all hospital operational data
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:your-password@localhost:5432/mednexus

# Platform database — LATLOMP business data (hospitals, subscriptions, admins)
PLATFORM_DATABASE_URL=postgresql+asyncpg://postgres:your-password@localhost:5432/mednexus_platform


# ── Redis ─────────────────────────────────────────────────────────────────────
# Used by: rate limiting (slowapi), Celery broker, Celery result backend
# Development: redis://localhost:6379
# Production: redis://:password@your-redis-host:6379/0
REDIS_URL=redis://localhost:6379


# ── Celery ────────────────────────────────────────────────────────────────────
# Leave blank to use REDIS_URL for both broker and result backend.
# Override only if you want a separate Redis instance for Celery.
# Example: redis://:password@celery-redis-host:6379/1
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=


# ── Security: Hospital JWT ────────────────────────────────────────────────────
# Signs tokens for hospital users (doctors, nurses, admins, etc.)
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# REQUIRED — app will not start without this
SECRET_KEY=your-secret-key-here

# JWT algorithm — do not change
ALGORITHM=HS256

# Access token lifetime in minutes (short-lived)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (long-lived, stored in Redis blocklist on logout)
REFRESH_TOKEN_EXPIRE_DAYS=7


# ── Security: Platform Admin JWT ──────────────────────────────────────────────
# Signs tokens for platform admins only — completely separate from hospital tokens
# A compromised hospital token cannot access platform admin routes
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# REQUIRED — app will not start without this
PLATFORM_SECRET_KEY=your-platform-secret-key-here


# ── Google OAuth ──────────────────────────────────────────────────────────────
# Used for hospital user authentication (Google Sign-In)
# Create credentials at: https://console.cloud.google.com
# Set the redirect URI to match GOOGLE_REDIRECT_URI below

# Your OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Your OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=your-google-client-secret

# The callback URL Google redirects to after sign-in
# Development: http://localhost:8000/api/v1/hospital/auth/google/callback
# Production:  https://api.mednexus.com/api/v1/hospital/auth/google/callback
# Must match exactly what is registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/hospital/auth/google/callback


# ── Paystack ──────────────────────────────────────────────────────────────────
# Payment provider for hospital subscription billing
# Test keys: from https://dashboard.paystack.com (Settings → API Keys)
# Live keys: use only after go-live with a dedicated MedNexus business account
# See ADR-007 in docs/DECISIONS.md for payment provider architecture notes

# Secret key — used server-side only, never expose to frontend
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key

# Public key — safe to expose to frontend (not used in backend directly)
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key


# ── File Storage: Cloudflare R2 ───────────────────────────────────────────────
# S3-compatible object storage for generated PDFs (invoices, prescriptions, lab reports)
# Create a bucket at: https://dash.cloudflare.com → R2 Object Storage
# See ADR-008 in docs/DECISIONS.md for storage architecture notes

# Your Cloudflare account ID (found in the Cloudflare dashboard right sidebar)
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 API token Access Key ID
# Create at: Cloudflare → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=your-r2-access-key-id

# R2 API token Secret Access Key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Name of the R2 bucket to store generated documents
R2_BUCKET_NAME=mednexus-files

# Optional: Public URL if the bucket has public access enabled
# Leave blank if using presigned URLs only (recommended for PHI documents)
R2_PUBLIC_URL=


# ── Email: Resend ─────────────────────────────────────────────────────────────
# Used for: staff invitation emails, critical lab result notifications,
#           support ticket reply notifications
# Create account at: https://resend.com
# Development: use onboarding@resend.dev as FROM_EMAIL (no domain verification needed)
# Production: verify your domain at Resend and use noreply@mednexus.com

# Email provider identifier — only "resend" is currently supported
EMAIL_PROVIDER=resend

# Resend API key — create at https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# From address for all outgoing emails
# Development: onboarding@resend.dev
# Production:  noreply@mednexus.com (requires domain verification in Resend)
FROM_EMAIL=onboarding@resend.dev


# ── Frontend URL ──────────────────────────────────────────────────────────────
# Used to build links in emails (staff invitation links, etc.)
# Development: http://localhost:3000
# Production:  https://app.mednexus.com
FRONTEND_URL=http://localhost:3000